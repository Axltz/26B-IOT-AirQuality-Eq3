{
  "expo": {
    "name": "Mi Entorno",
    "slug": "mi-entorno",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mientorno.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Mi Entorno se conecta a tu ESP32 en la red Wi-Fi de tu casa para leer la temperatura, la humedad y la calidad del aire."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mientorno.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Mi Entorno",
      "backgroundColor": "#F4F5F0"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#E0533B",
          "defaultChannel": "alertas-aire"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "mientorno",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a916cc9a-d0fa-4b81-a299-4fdaf8e7bb87"
      }
    },
    "owner": "gustavo12bonilla"
  }
}
